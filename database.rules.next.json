{
  "rules": {
    "groups": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || auth.uid === data.child('host').val() || (!newData.exists() && (!data.child('members').exists() || (data.child('createdAt').exists() && now - data.child('createdAt').val() > ((data.child('status').val() === 'playing' || data.child('status').val() === 'started') ? 43200000 : 3600000)))))",
        ".validate": "$g.length <= 64",
        "members": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))"
          }
        },
        "$a": {
          ".validate": "!newData.isString() || newData.val().length <= 4096",
          "$b": {
            ".validate": "!newData.isString() || newData.val().length <= 4096",
            "$c": {
              ".validate": "!newData.isString() || newData.val().length <= 4096"
            }
          }
        }
      }
    },
    "states": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && ((!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()) || auth.uid === root.child('groups').child($g).child('host').val())",
        ".validate": "$g.length <= 64"
      }
    },
    "live": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "claims": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "ready": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "bots": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "token": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "cmds": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "beat": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "pause": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "nudges": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "claimwin": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "debug": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null && (root.child('groups').child($g).child('members').child(auth.uid).exists() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))",
        ".validate": "$g.length <= 64"
      }
    },
    "pings": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null",
        ".validate": "$g.length <= 64",
        "$req": {
          ".validate": "!newData.exists() || newData.hasChildren(['from'])",
          "$f": {
            ".validate": "!newData.isString() || newData.val().length <= 128"
          }
        }
      }
    },
    "pongs": {
      ".read": "auth != null",
      "$g": {
        ".write": "auth != null",
        ".validate": "$g.length <= 64",
        "$req": {
          "$who": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          }
        }
      }
    },
    "hands": {
      "$g": {
        ".validate": "$g.length <= 64",
        ".write": "auth != null && (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists())",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && ((!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()) || auth.uid === root.child('groups').child($g).child('host').val())"
        }
      }
    },
    "secret": {
      "$g": {
        ".validate": "$g.length <= 64",
        ".read": "auth != null && auth.uid === root.child('groups').child($g).child('host').val()",
        ".write": "auth != null && (auth.uid === root.child('groups').child($g).child('host').val() || (!root.child('groups').child($g).exists() || !root.child('groups').child($g).child('members').exists()))"
      }
    },
    "camps": {
      ".read": "auth != null",
      "$c": {
        ".validate": "$c.length <= 64",
        ".write": "auth != null && !newData.exists()",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('stub').val() === true))",
            ".validate": "!newData.exists() || (newData.hasChildren(['at']) && (!newData.child('name').exists() || newData.child('name').val().length <= 20))"
          }
        }
      }
    }
  }
}
